# submitslurm command – key commonly used parameters (see full: submitslurm -h)
#
# -w / --working-dir    : Select working subdirectory where the script runs. Default to wd, list of dirs can be provided as comma separated list (e.g. wd1,wd2,wd3) and then the script is scheduled for each of them.
# -a / --slurmargs      : Pass additional arguments to the generated sbatch scripts.
# -f / --partition      : Choose partition (e.g. 'com', 'comgpu' for H200 nodes, etc.).
# -g / --gpu-nodes      : Restrict selection to GPU nodes (type‑agnostic).
# -e / --excellent-nodes / -s / --strong-nodes : Use only excellent A100+ nodes (-e) or strong CPU nodes (-s).
# --pipeline-step : Specify integer pipeline step to run (e.g. 1, 2, 3, etc.) given command is then scheduled only if all previous steps are completed. This is for pipelines where each step is dependent on the previous one.
# -p / --pattern : Restrict selection to subdirectories of wd matching the provided pattern (e.g. '001'). Can be used to match only specific scans from the beamtime.

---------------------------
Pipeline for reconstruction
---------------------------

#Use setupPipelineForBeamtime script or lautools-browser beamtime->project from recipe to generate this file 
#PATH=$PATH:/data/hereon/wp/group/laupy/bin/ ... if you do not have kct- and dentk- tools in path

#Execute script to create wd directory with individual folders corresponding to scans from beamtime or use lautools-browser workspace->create wd
#script/00createWorkingDirectory

# Run diagnostics of the individual scans to see intensity profile or current correction shift
submitslurm --pipeline-step 0 01scanTimingDiagnostics.sbatch

# 1) Create lossless HTJ2K Zarr
submitslurm --pipeline-step 1 -a "--compression htj2k --zip --clevel 0 --output-prefix h2k_ll" 01createZarrStructure.sbatch

# 2) Destar
submitslurm --pipeline-step 2 -a "--zar-input-file h2k_ll.zar --suffix _ll_clean" 02destar.sbatch

# 3) Dark field correction
submitslurm --pipeline-step 3 -a "--img img_ll_clean.den --ref ref_ll_clean.den --dar dar_ll_clean.den --remove-input-files" 03darkFieldCorrect.sbatch

# 4) Current correction
submitslurm --pipeline-step 4 -a "--fix-corrupted-h5 --img img_ll_clean_darksub.den --ref ref_ll_clean_darksub.den --remove-input-files" 05currentCorrect.sbatch

# 5) Compute extinction
submitslurm --pipeline-step 5 -a "--img img_ll_clean_darksub_curcor.den --ref ref_ll_clean_darksub_curcor.den --out ext_ll.den --remove-input-files" 06computeExtinction.sbatch

# 6) Detect rotation center from h5
submitslurm --pipeline-step 6 -a "ext_ll.den" 07detectRotationCenter180.sbatch

# 7) Bin extinction directly by 2 in X and Y (median binning; creates extb2/)
submitslurm --pipeline-step 7 -a "--bin 2 ext_ll.den extb2/ext_ll.den" 00bin.sbatch

#Remove un-binned file
submitslurm --pipeline-step 8 -a " -f ext_ll.den" 00remove.sbatch

# 8) FBP filtering: symmetric padding and Kaiser window, beta=5
submitslurm --pipeline-step 8 -f allgpu -a "--binning 2 --pad-symm --window-kaiser --window-kaiser-beta 5 extb2/ext_ll.den extb2/ext_ll_kaiser.den" 09filterFBP.sbatch

# 9) Backproject the filtered extinction using h5 geometry
submitslurm --pipeline-step 9 -s -g -a "--binning 2 --geometry-info h5 --rotation-axis-file ext_ll_rotationcenter180.log --straight-rotation-axis --backproject extb2/ext_ll_kaiser.den" 00reconstructCGLS.sbatch

#Remove source files
submitslurm --pipeline-step 10 -a " -f extb2/*.den " 00remove.sbatch
submitslurm --pipeline-step 10 -a " -f *zar" 00remove.sbatch
submitslurm --pipeline-step 10 -a " -r -f tmp*" 00remove.sbatch

