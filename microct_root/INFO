#
#There is very questionable pattern in sinograms wave like, lets test with classical current correction
#This is due to missing current correction lets correct for it with trigonometric fit
submitslurm 05currentCorrect.sbatch
submitslurm 08binExtinctions.sbatch
#Perform kct-rof --relaxed --force --max-iterations-pdhg 300 --chunk-size 20  --pdhg-mu -0.1 -p 1:3 --gradient-forward-3point --pdhg-sigma -0.2 --pdhg-tau -0.2 testdata_ring.den testdata_ring_rofa.den
submitslurm -x -f allgpu  -a "--rotation-axis-file ext_legacy_rotationcenter.log extb2_curcor/ext_curcor.den" 00reconstructCGLS.sbatch
submitslurm -f com 09binFlatFields.sbatch
submitslurm 13svd.sbatch
submitslurm -f com -n max-ittg001  -a "--rotation-axis-file ext_curcor_rotationcenter.log extb2_curcor/ext_ref_v5.den" 00reconstructCGLS.sbatch
submitslurm -f com -n max-ittg001  -a "--rotation-axis-file ext_curcor_rotationcenter.log extb2_curcor/ext_ref_v10.den" 00reconstructCGLS.sbatch


#Try FBP reconstruction
submitslurm -f allgpu -p cnk_233_LCD_ST001_p2_a 24filterEXTFBP.sbatch
