#!/bin/bash
echo "03flatFieldCorrect $PWD"

PHASECONTRAST=false

function testExistence(){
if [[ ! -f $1 ]]; then
    	echo "File $1 does not exist."
		exit 1
fi
}

function flatFieldCorrect(){
    MINFLAT=1.0
    MINIMG=$(awk 'BEGIN {print 1.0/1024.0}')
    DARK=${1%.den}
    FLAT=${2%.den}
    IMG=${3%.den}
    TRA=${4%.den}
    EXT=${5%.den}
	testExistence "${IMG}.den"
	testExistence "${FLAT}.den"
	testExistence "${DARK}.den"
    rm -f ${DARK}_med
    rm -f ${FLAT}_med
    rm -f ${FLAT}_sub
    rm -f ${FLAT}_cor
    rm -f ${IMG}_sub
    rm -f ${IMG}_max
    rm -f ${IMG}_cor
    rm -f ${TRA}.den
    rm -f ${EXT}_exp.den
    rm -f ${EXT}.den
    ARG="--force -j 32"
    dentk-framecalc1 --force --median ${DARK}.den ${DARK}_med
    dentk-framecalc1 --force --median ${FLAT}.den ${FLAT}_med
    dentk-calc ${ARG} --subtract ${FLAT}_med ${DARK}_med ${FLAT}_sub
    dentk-calc1 ${ARG} --max ${MINFLAT} ${FLAT}_sub ${FLAT}_cor 
    dentk-framecalc ${ARG} --subtract ${IMG}.den ${DARK}_med ${IMG}_sub
    dentk-calc1 ${ARG} --max ${MINIMG} ${IMG}_sub ${IMG}_max
	if [ "$PHASECONTRAST" = true ]; then
		mv ${IMG}_max ${IMG}_cor
	else
		#START does not apply for phase contrast
    	dentk-framecalc ${ARG} --min ${IMG}_max ${FLAT}_cor ${IMG}_cor
		#END does not apply for phase contrast
	fi
    dentk-framecalc ${ARG} --divide ${IMG}_cor ${FLAT}_cor ${TRA}.den
    dentk-calc1 ${ARG} --inv ${TRA}.den ${EXT}_exp.den
    dentk-calc1 ${ARG} --log  ${EXT}_exp.den ${EXT}.den
    rm -f ${DARK}_med
    rm -f ${FLAT}_med
    rm -f ${FLAT}_sub
    rm -f ${FLAT}_cor
    rm -f ${IMG}_sub
    rm -f ${IMG}_max
    rm -f ${IMG}_cor
    rm -f ${EXT}_exp.den
    rm -f ${TRA}.den
}

if [ "$#" -ne 5 ]; then
	echo "Expecting 5 inputs DAR FLAT IMG TRA EXT"
	exit 1
fi

DARK=$1
FLAT=$2
IMG=$3
TRA=$4
EXT=$5
if [[ -f $EXT && ! -f $TRA ]]; then
	echo "File ${TRA} does not exist and ${EXT} does, flat field correction was probably jet succesfully performed, to rerun it remove ${EXT}."
else
	echo "Starting flat field correction of ${IMG} DAR=${DARK} REF=${FLAT} to produce TRA=${TRA} and EXT=${EXT}"
	flatFieldCorrect ${DARK} ${FLAT} ${IMG} ${TRA} ${EXT}
fi
