submitslurm --pipeline-step 1 -a " LogScan.log raw  --foreign-log-file dar/LogScan.log  --foreign-raw-dir dar/raw --compression htj2k --zip --clevel 0 --output-prefix h2k_ll" 01createZarrStructure.sbatch

#Destar of dark fields and zinger removal for flat fields and img produces img/dar/ref_clean.den
submitslurm --pipeline-step 2 -a " --zar-input-file h2k_ll.zar --suffix _ll_clean" 02destar.sbatch

#Dark field correction
submitslurm --pipeline-step 3 -a " --img img_ll_clean.den --ref ref_ll_clean.den --dar dar_ll_clean.den --remove-input-files" 03darkFieldCorrect.sbatch

#Current correction
submitslurm --pipeline-step 4  -a "--nano-log-file LogScan.log --nano-image-dir raw --force --img img_ll_clean_darksub.den --ref ref_ll_clean_darksub.den" 05currentCorrect.sbatch

#Field statistics, including SNR and photon statistics ... required for 05estimateRegions
submitslurm --pipeline-step 5 -a " --img img_ll_clean_darksub_curcor.den --ref ref_ll_clean_darksub_curcor.den" 05estimateFieldStatistics.sbatch

#Estimate regions
submitslurm --pipeline-step 6 -a " --img img_ll_clean_darksub_curcor.den --ref ref_ll_clean_darksub_curcor.den" 05estimateRegions.sbatch

#Compute extinction by standard pipeline
submitslurm --pipeline-step 7 -a " --img img_ll_clean_darksub_curcor.den --ref ref_ll_clean_darksub_curcor.den --out ext_ll.den" 06computeExtinction.sbatch

#Estimate rotation center
submitslurm --pipeline-step 8 -a " --regions-json ref_ll_clean_darksub_curcor.json --nano-log-file LogScan.log ext_ll.den" 07detectRotationCenter180.sbatch

#Create binned data
submitslurm --pipeline-step 9 -a " ext_ll.den extb2/ext_ll.den" 00bin.sbatch

#SSC filter
submitslurm --pipeline-step 10 -f allgpu -a "--sm-size 201 --la-size 301 extb2/ext_ll.den extb2/ext_ll_ssc.den" 00sinogramStripCorrection.sbatch
