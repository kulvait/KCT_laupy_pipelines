# submitslurm command – key commonly used parameters (see full: submitslurm -h)
#
# -w / --working-dir    : Select working subdirectory where the script runs. Default to wd, list of dirs can be provided as comma separated list (e.g. wd1,wd2,wd3) and then the script is scheduled for each of them.
# -a / --slurmargs      : Pass additional arguments to the generated sbatch scripts.
# -f / --partition      : Choose partition (e.g. 'com', 'comgpu' for H200 nodes, etc.).
# -g / --gpu-nodes      : Restrict selection to GPU nodes (type‑agnostic).
# -e / --excellent-nodes / -s / --strong-nodes : Use only excellent A100+ nodes (-e) or strong CPU nodes (-s).
# --pipeline-step : Specify integer pipeline step to run (e.g. 1, 2, 3, etc.) given command is then scheduled only if all previous steps are completed. This is for pipelines where each step is dependent on the previous one.
# -p / --pattern : Restrict selection to subdirectories of wd matching the provided pattern (e.g. '001'). Can be used to match only specific scans from the beamtime.

---------------------------------------------
Pipeline for reconstruction in nanotomography
---------------------------------------------
#Create working directory with samples using eg. lautools-browser, script/00createWorkingDirectory or calling createWorkingDirectoryForMicrotomography

#Create subdirectory dar in each wd folder which shall point to dark field project

#Run diagnostics of the individual scans to see intensity profile or current correction shift
submitslurm --pipeline-step 0 01scanTimingDiagnostics.sbatch

#You might want symlink darkfield measurement to each folder e.g. when dark sample is wd_dar/nano17222_pco_darks_0p1 then you run
#submitslurm --pipeline-step 0 -a " ../../wd_dar/nano17222_pco_darks_0p1 dar" 00symlink.sbatch

#Tiff to den format conversion
submitslurm --pipeline-step 1 -a " LogScan.log raw  --foreign-log-file dar/LogScan.log  --foreign-raw-dir dar/raw --compression htj2k --zip --clevel 0 --output-prefix h2k_ll" 01createZarrStructure.sbatch

#Destar of dark fields and zinger removal for flat fields and img produces img/dar/ref_clean.den
submitslurm --pipeline-step 2 -a " --zar-input-file h2k_ll.zar --suffix _ll_clean" 02destar.sbatch

#Dark field correction
submitslurm --pipeline-step 3 -a " --img img_ll_clean.den --ref ref_ll_clean.den --dar dar_ll_clean.den --remove-input-files" 03darkFieldCorrect.sbatch

#Current correction
submitslurm --pipeline-step 4  -a "--nano-log-file LogScan.log --nano-image-dir raw --force --img img_ll_clean_darksub.den --ref ref_ll_clean_darksub.den" 05currentCorrect.sbatch

#Field statistics, including SNR and photon statistics ... required for 05estimateRegions
submitslurm --pipeline-step 5 -a " --img img_ll_clean_darksub_curcor.den --ref ref_ll_clean_darksub_curcor.den" 05estimateFieldStatistics.sbatch

#Estimate regions
submitslurm --pipeline-step 6 -a " --img img_ll_clean_darksub_curcor.den --ref ref_ll_clean_darksub_curcor.den" 05estimateRegions.sbatch

#Compute extinction by standard pipeline
submitslurm --pipeline-step 7 -a " --img img_ll_clean_darksub_curcor.den --ref ref_ll_clean_darksub_curcor.den --out ext_ll.den" 06computeExtinction.sbatch

#Estimate rotation center
submitslurm --pipeline-step 8 -a " --regions-json ref_ll_clean_darksub_curcor.json --nano-log-file LogScan.log ext_ll.den" 07detectRotationCenter180.sbatch

#Create binned data
submitslurm --pipeline-step 9 -a " ext_ll.den extb2/ext_ll.den" 00bin.sbatch

#SSC filter
submitslurm --pipeline-step 10 -f allgpu -a "--sm-size 201 --la-size 301 extb2/ext_ll.den extb2/ext_ll_ssc.den" 00sinogramStripCorrection.sbatch
#--sm-size 201 --la-size 301 --snr 2 ... large ring artefacts
#--sm-size 151 --la-size 251 --snr 2 or --sm-size 101 --la-size 201 for medium size rings

