# Validate one or more values:
# require_value OPTION VALUE [VALUE ...]
require_value() {
    local option="${1:-option}" value
    shift || return 2

    if (($# == 0)); then
        echo "Error: $option requires a value." >&2
        return 2
    fi

    for value in "$@"; do
        if [[ -z "$value" || "$value" == --* ]]; then
            echo "Error: missing value for $option." >&2
            return 2
        fi
    done
}

#CGLS with optional Bronikov regularization and sinogram strip correction
cgls_reconstruction() {
    local BRONIKOVPAR=0 STRIPSMPAR=0 STRIPLAPAR=0 SUFFIX=""
    local EXTB2="" BASENAME STEM EXT IN OUT OUTSTR RANDOMID REC_ARG RECDIR NODE_NAME
    local TCK="LogScan.tck"
    local LASTDEP=10 FILE REMOVE_INDEX=0
    local -a OUTFILES=()
    local USAGE="Usage: cgls_reconstruction [--bronikov N] [--strip SM LA] [--suffix SUFFIX] FILE"

    while (($#)); do
        case "$1" in
            --bronikov) require_value "$1" "${2:-}" || return $?; BRONIKOVPAR="$2"; shift 2 ;;
            --strip)    require_value "$1" "${2:-}" "${3:-}" || return $?; STRIPSMPAR="$2"; STRIPLAPAR="$3"; shift 3 ;;
            --suffix)   require_value "$1" "${2:-}" || return $?; SUFFIX="$2"; shift 2 ;;
            --tck)      require_value "$1" "${2:-}" || return $?; TCK="$2"; shift 2 ;;
            -h|--help)  echo "$USAGE"; return 0 ;;
            --)         shift; break ;;
            -*)         echo "Error: unknown option '$1'." >&2; return 2 ;;
            *)          break ;;
        esac
    done

    if (($# != 1)) || [[ -z "${1:-}" ]]; then
        echo "$USAGE" >&2
        return 2
    fi
    EXTB2="$1"

    # Validate before submitting any jobs.
    local NUMBER='^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$'
    if [[ ! "$BRONIKOVPAR" =~ $NUMBER ]]; then
        echo "Error: --bronikov requires a nonnegative number." >&2
        return 2
    fi
    if [[ ! "$STRIPSMPAR" =~ ^[0-9]+$ || ! "$STRIPLAPAR" =~ ^[0-9]+$ ]]; then
        echo "Error: --strip requires two nonnegative integers." >&2
        return 2
    fi

    # -a is a serialized argument string: keep paths/suffixes shell-safe.
    if [[ ! "$EXTB2" =~ ^[a-zA-Z0-9_./+-]+$ || ! "$SUFFIX" =~ ^[a-zA-Z0-9_.-]*$ || ! "$TCK" =~ ^[a-zA-Z0-9_./+-]+$ ]]; then
        echo "Error: FILE, TCK or SUFFIX contains unsupported whitespace or shell characters." >&2
        return 2
    fi

    BASENAME="${EXTB2##*/}"
    if [[ "$BASENAME" != *.* || "$BASENAME" == .* || "$BASENAME" == *. ]]; then
        echo "Error: FILE must have a nonempty stem and extension." >&2
        return 2
    fi
    STEM="${BASENAME%.*}"
    EXT="${BASENAME##*.}"

    # Bounded read: no SIGPIPE-producing tr | head pipeline.
    RANDOMID=$(od -An -N8 -tx1 /dev/urandom) || return $?
    RANDOMID="${RANDOMID//[[:space:]]/}"

    IN="$EXTB2"
    OUTSTR="$STEM"

    echo "Starting CGLS reconstruction: $EXTB2, RANDOMID: $RANDOMID, SUFFIX: $SUFFIX"
    echo "Bronikov: $BRONIKOVPAR; strip SM/LA: $STRIPSMPAR/$STRIPLAPAR"

    # Optional Bronikov regularization.
    if [[ ! "$BRONIKOVPAR" =~ ^0+([.]0+)?([eE][+-]?[0-9]+)?$ ]]; then
        NODE_NAME="1_BRO_${RANDOMID}"
        OUTSTR+="_bro${BRONIKOVPAR}"
        OUT="extb2/${OUTSTR}_${RANDOMID}.${EXT}"

        submitslurm --pipeline-step "$NODE_NAME" --dependencies "$LASTDEP" -g -a "$BRONIKOVPAR $IN $OUT" 00regularizedBronikov.sbatch || return $?

        LASTDEP="$NODE_NAME"
        OUTFILES+=("$OUT")
        IN="$OUT"
    fi

    # Optional sinogram strip correction.
    if [[ ! "$STRIPSMPAR" =~ ^0+$ ]]; then
        NODE_NAME="2_SSC_${RANDOMID}"
        OUTSTR+="_ssc_sm${STRIPSMPAR}_LA${STRIPLAPAR}"
        OUT="extb2/${OUTSTR}_${RANDOMID}.${EXT}"

        submitslurm --pipeline-step "$NODE_NAME" --dependencies "$LASTDEP" -f allgpu -a " --sm-size $STRIPSMPAR --la-size $STRIPLAPAR $IN $OUT" 00sinogramStripCorrection.sbatch || return $?

        LASTDEP="$NODE_NAME"
        OUTFILES+=("$OUT")
        IN="$OUT"
    fi

     # Normalize the final input filename for reconstruction:
     # Strip ${RANDOMID} from any temp file so derived reconstruction folder names are predictable
     # If no preprocessing ran, use the original EXTB2 input as-is.
    if ((${#OUTFILES[@]})); then
        IN="${OUTFILES[-1]}"
        OUT="extb2/${OUTSTR}.${EXT}"

        # Move only when source and target differ.
        if [[ "$IN" != "$OUT" ]]; then
            NODE_NAME="3_MOV_${RANDOMID}"
            submitslurm --pipeline-step "$NODE_NAME" --dependencies "$LASTDEP" -a " $IN $OUT" 00move.sbatch || return $?
            LASTDEP="$NODE_NAME"
            IN="$OUT"
            #Update outfiles array
            unset 'OUTFILES[-1]'
            OUTFILES+=("$OUT")
        fi
    else
        # No bronikov and no strip: nothing to move, reconstruct directly from original input.
        IN="$EXTB2"
    fi

    # Reconstruct the latest branch output, or the original input if
    # neither preprocessing stage was requested.
    
    BASENAME="${IN##*/}"
    STEM="${BASENAME%.*}"
    RECDIR="recb2_cgls_${STEM}"

    REC_ARG="--rotation-axis-file ext_ll_rotationcenter180.log --geometry-info $TCK"
    if [[ -n "$SUFFIX" ]]; then
        REC_ARG+=" --output-suffix $SUFFIX"
        RECDIR+="_${SUFFIX}"
    fi
    REC_ARG+=" $IN"

    echo "Scheduling CGLS reconstruction into $RECDIR"
    NODE_NAME="5_REC_${RANDOMID}"
    submitslurm --pipeline-step "$NODE_NAME" --dependencies "$LASTDEP" -s -g -a "$REC_ARG" 00reconstructCGLS.sbatch || return $?
    LASTDEP="$NODE_NAME"
    CLEANUPDEPS+=("$NODE_NAME")

    # One removal call per generated intermediate.
    NODE_NAME="6_REMOVE_${RANDOMID}"
    for FILE in "${OUTFILES[@]}"; do
        REMOVE_INDEX=$((REMOVE_INDEX + 1))
        echo "Scheduling cleanup of intermediate file: $FILE (index $REMOVE_INDEX)"
        submitslurm --pipeline-step "$NODE_NAME" --dependencies "$LASTDEP" -a " -f $FILE" 00remove.sbatch || return $?
    done

    # Also wait for branch-local removals before final directory cleanup.
    if ((${#OUTFILES[@]})); then
        CLEANUPDEPS+=("$NODE_NAME")
    fi

    return 0
}

#FBP with Kaiser and optional Bronikov regularization and sinogram strip correction
fbp_reconstruction() {
    local BRONIKOVPAR=0 KAISERPAR=5 STRIPSMPAR=0 STRIPLAPAR=0 SUFFIX=""
    local EXTB2="" BASENAME STEM EXT IN OUT OUTSTR RANDOMID REC_ARG NODE_NAME
    local TCK="LogScan.tck"
    local LASTDEP=10 FILE REMOVE_INDEX=0
    local -a OUTFILES=()
    local USAGE="Usage: fbp_reconstruction [--bronikov N] [--kaiser N] [--strip SM LA] [--suffix SUFFIX] [--tck FILE] FILE"

    while (($#)); do
        case "$1" in
            --bronikov) require_value "$1" "${2:-}" || return $?; BRONIKOVPAR="$2"; shift 2 ;;
            --kaiser)   require_value "$1" "${2:-}" || return $?; KAISERPAR="$2"; shift 2 ;;
            --strip)    require_value "$1" "${2:-}" "${3:-}" || return $?; STRIPSMPAR="$2"; STRIPLAPAR="$3"; shift 3 ;;
            --suffix)   require_value "$1" "${2:-}" || return $?; SUFFIX="$2"; shift 2 ;;
            --tck)      require_value "$1" "${2:-}" || return $?; TCK="$2"; shift 2 ;;
            -h|--help)  echo "$USAGE"; return 0 ;;
            --)         shift; break ;;
            -*)         echo "Error: unknown option '$1'." >&2; return 2 ;;
            *)          break ;;
        esac
    done

    if (($# != 1)) || [[ -z "${1:-}" ]]; then
        echo "$USAGE" >&2
        return 2
    fi
    EXTB2="$1"

    # Validate before submitting any jobs.
    local NUMBER='^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$'
    if [[ ! "$BRONIKOVPAR" =~ $NUMBER || ! "$KAISERPAR" =~ $NUMBER ]]; then
        echo "Error: --bronikov and --kaiser require nonnegative numbers." >&2
        return 2
    fi
    if [[ ! "$STRIPSMPAR" =~ ^[0-9]+$ || ! "$STRIPLAPAR" =~ ^[0-9]+$ ]]; then
        echo "Error: --strip requires two nonnegative integers." >&2
        return 2
    fi

    # -a is a serialized argument string: keep paths/suffixes shell-safe.
    if [[ ! "$EXTB2" =~ ^[a-zA-Z0-9_./+-]+$ || ! "$SUFFIX" =~ ^[a-zA-Z0-9_.-]*$ || ! "$TCK" =~ ^[a-zA-Z0-9_./+-]+$ ]]; then
        echo "Error: FILE, TCK or SUFFIX contains unsupported whitespace or shell characters." >&2
        return 2
    fi

    BASENAME="${EXTB2##*/}"
    if [[ "$BASENAME" != *.* || "$BASENAME" == .* || "$BASENAME" == *. ]]; then
        echo "Error: FILE must have a nonempty stem and extension." >&2
        return 2
    fi
    STEM="${BASENAME%.*}"
    EXT="${BASENAME##*.}"

    # No tr | head pipeline: safe with pipefail and no SIGPIPE issue.
    RANDOMID=$(tr -dc 'A-Z0-9' < /dev/urandom | head -c 5) || return $?

    IN="$EXTB2"
    OUTSTR="$STEM"
    LASTDEP="10"  # The last step before reconstruction is the SSC filter, which is step 10.

    echo "Starting FBP reconstruction: $EXTB2, RANDOMID: $RANDOMID, SUFFIX: $SUFFIX"
    echo "Bronikov: $BRONIKOVPAR; Kaiser: $KAISERPAR; strip SM/LA: $STRIPSMPAR/$STRIPLAPAR"
    # Treat all numeric representations of zero as disabled.
    if [[ ! "$BRONIKOVPAR" =~ ^0+([.]0+)?([eE][+-]?[0-9]+)?$ ]]; then
        NODE_NAME="1_BRO_${RANDOMID}"
        OUTSTR+="_bro${BRONIKOVPAR}"
        OUT="extb2/${OUTSTR}_${RANDOMID}.${EXT}"
        submitslurm --pipeline-step "${NODE_NAME}" --dependencies "$LASTDEP" -g -a "$BRONIKOVPAR $IN $OUT" 00regularizedBronikov.sbatch || return $?
        LASTDEP="${NODE_NAME}"
        OUTFILES+=("$OUT")
        IN="$OUT"
    fi

    if [[ ! "$STRIPSMPAR" =~ ^0+$ ]]; then
        NODE_NAME="2_SSC_${RANDOMID}"
        OUTSTR+="_ssc_sm${STRIPSMPAR}_LA${STRIPLAPAR}"
        OUT="extb2/${OUTSTR}_${RANDOMID}.${EXT}"
        submitslurm --pipeline-step "${NODE_NAME}" --dependencies "$LASTDEP" -f allgpu -a "--sm-size $STRIPSMPAR --la-size $STRIPLAPAR $IN $OUT" 00sinogramStripCorrection.sbatch || return $?
        LASTDEP="${NODE_NAME}"
        OUTFILES+=("$OUT")
        IN="$OUT"
    fi

    # Always filter. Keep this output; only temporary stages enter OUTFILES.
    NODE_NAME="3_KAI_${RANDOMID}"
    OUTSTR+="_kai${KAISERPAR}"
    OUT="extb2/${OUTSTR}.${EXT}"
    submitslurm --pipeline-step "${NODE_NAME}" --dependencies "$LASTDEP" -f allgpu -a "--pad-symm --window-kaiser --window-kaiser-beta $KAISERPAR $IN $OUT" 09filterFBP.sbatch || return $?
    LASTDEP="${NODE_NAME}"
    OUTFILES+=("$OUT")

    #Reconstruction step, dependent on the last filter step. Output is in recb2_cgls_${STEM} or recb2_cgls_bro${REGPAR}_${STEM}${SUFFIX}
    REC_ARG="--rotation-axis-file ext_ll_rotationcenter180.log --backproject --geometry-info $TCK"
    if [[ -n "$SUFFIX" ]]; then
        REC_ARG+=" --output-suffix $SUFFIX"
    fi
    REC_ARG+=" $OUT"
    NODE_NAME="5_REC_${RANDOMID}"
    submitslurm --pipeline-step "${NODE_NAME}" --dependencies "$LASTDEP" -s -g -a "$REC_ARG" 00reconstructCGLS.sbatch || return $?
    LASTDEP="${NODE_NAME}"
    CLEANUPDEPS+=("${NODE_NAME}")

    # One cleanup job per intermediate, all dependent on reconstruction.
    NODE_NAME="6_REMOVE_${RANDOMID}"
    for FILE in "${OUTFILES[@]}"; do
        REMOVE_INDEX=$((REMOVE_INDEX + 1))
        echo "Scheduling cleanup of intermediate file: $FILE (index $REMOVE_INDEX)"
        submitslurm --pipeline-step "${NODE_NAME}" --dependencies "${LASTDEP}" -a " -f $FILE" 00remove.sbatch || return $?
    done

    return 0
}
