#CGLS with Bronikov
cgls_reconstruction() {
    local REGPAR="$1"
    local EXTB2="$2"
    local SUFFIX="${3:-}"

    local BASENAME
    BASENAME="$(basename "$EXTB2")"

    local STEM="${BASENAME%.*}"
    local EXT="${BASENAME##*.}"

    local BROB2="extb2/bro${REGPAR}_${STEM}${SUFFIX}.${EXT}"
    local RECDIR="recb2_cgls_${STEM}"
    RECDIR="recb2_cgls_bro${REGPAR}_${STEM}${SUFFIX}"

    echo "Starting reconstruction of $EXTB2 with bronikov regpar $REGPAR to produce ${BROB2} and ${RECDIR}"

    submitslurm --pipeline-step 11 -a " -r -f $RECDIR" 00remove.sbatch
    submitslurm --pipeline-step 11 -a " -f $BROB2" 00remove.sbatch
    submitslurm --pipeline-step 12 -g -a "$REGPAR $EXTB2 $BROB2" 00regularizedBronikov.sbatch


    local REC_ARG="--rotation-axis-file ext_ll_rotationcenter180.log --geometry-info LogScan.tck"
    if [[ -n "$SUFFIX" ]]; then
        REC_ARG+=" --output-suffix $SUFFIX"
    fi
    REC_ARG+=" $BROB2"
    submitslurm --pipeline-step 15 -s -g -a "${REC_ARG}" 00reconstructCGLS.sbatch
}

#FBP with Bronikov
fbp_reconstruction() {
    local REGPAR="$1"
    local KAISERPAR="$2"
    local EXTB2="$3"
    local SUFFIX="${4:-}"

    local BASENAME
    BASENAME="$(basename "$EXTB2")"
    local STEM="${BASENAME%.*}"
    local EXT="${BASENAME##*.}"

    local BROB2="extb2/bro${REGPAR}_${STEM}${SUFFIX}.${EXT}"
    local KAIB2="extb2/bro${REGPAR}_kai${KAISERPAR}_${STEM}${SUFFIX}.${EXT}"
    BASENAME="$(basename "$KAIB2")"
    STEM="${BASENAME%.*}"
    EXT="${BASENAME##*.}"
    local RECDIR="recb2_cgls_${STEM}"

    echo "Starting reconstruction of $EXTB2 with bronikov regpar $REGPAR and kaiser beta ${KAISERPAR} to produce ${BROB2} and ${KAIB2} and ${RECDIR}"
    submitslurm --pipeline-step 11 -a " -r -f $RECDIR" 00remove.sbatch
    submitslurm --pipeline-step 11 -a " -f $BROB2" 00remove.sbatch
    submitslurm --pipeline-step 11 -a " -f $KAIB2" 00remove.sbatch

    submitslurm --pipeline-step 12 -g -a "$REGPAR $EXTB2 $BROB2" 00regularizedBronikov.sbatch
    submitslurm --pipeline-step 13 -f allgpu -a " --pad-symm --window-kaiser --window-kaiser-beta ${KAISERPAR} ${BROB2} ${KAIB2}" 09filterFBP.sbatch
    local REC_ARG="--rotation-axis-file ext_ll_rotationcenter180.log --geometry-info LogScan.tck --backproject"
    if [[ -n "$SUFFIX" ]]; then
        REC_ARG+=" --output-suffix $SUFFIX"
    fi
    REC_ARG+=" $KAIB2"
    submitslurm --pipeline-step 14 -s -g -a "${REC_ARG}" 00reconstructCGLS.sbatch
}

#Bronikov ... moderate regularization, REGPAR closer to zero, stronger the regularization
#Closer bronikov regpar to 0 stronger regularization, higher kaiser beta stronger regularization
#cgls_reconstruction 0.001 extb2/ext_ll_ssc.den #Probably the best
#fbp_reconstruction 0.05 5 extb2/ext_ll_ssc.den
#fbp_reconstruction 0.005 5 extb2/ext_ll_ssc.den
fbp_reconstruction 0.001 5 extb2/ext_ll_ssc.den #Probably the best
#fbp_reconstruction 0.0005 5 extb2/ext_ll_ssc.den

#Cleanup
submitslurm --pipeline-step 19 -a " -f -r extb2 " 00remove.sbatch
submitslurm --pipeline-step 19 -a " *.den " 00remove.sbatch
submitslurm --pipeline-step 19 -a " *.zar " 00remove.sbatch

